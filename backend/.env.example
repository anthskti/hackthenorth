# OpenAI API Key
OPENAI_API_KEY=

# Vision model. Default gpt-4o (image-in, JSON-out).
# Budget tip: use gpt-4o-mini while iterating (~much cheaper per Run).
# OpenAI does not take native HDMI video — we send JPEG frames.
OPENAI_MODEL=gpt-4o

# Image detail: low | auto | high. Use low or auto to save $; high for tiny BIOS text.
OPENAI_IMAGE_DETAIL=auto

# QNX kvmd (HTTP, not WebSocket). Hostname or raw IP.
# GET  /stream         MJPEG
# GET  /snapshot.jpg   one JPEG
# POST /key            Leonardo lines, one per newline (kB0, ttext, …)
QNX_BASE_URL=http://172.20.10.11:8080
# QNX_STREAM_URL=http://172.20.10.11:8080/stream
# QNX_KEY_URL=http://172.20.10.11:8080/key
# QNX_SNAPSHOT_URL=http://172.20.10.11:8080/snapshot.jpg
# MJPEG frame size (kvmd default: 16:9 letterbox at 480p → 854×480). Match kvm -W/-h.
# QNX_STREAM_WIDTH=854
# QNX_STREAM_HEIGHT=480

# Max OpenAI+HID steps per Run (default 8).
AGENT_MAX_STEPS=8
